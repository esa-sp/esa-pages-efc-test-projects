    {
      "path": "/api/nested",
      "expectedStatus": 200,
      "bodyJsonSubset": { "module": "nested-commonjs" }
    },
    {
      "path": "/api/items/42",
      "expectedStatus": 200,
      "bodyJsonSubset": { "id": "42", "value": "alias-ts" }
