    { "path": "/__console/long?marker=check-long", "expectedStatus": 200, "bodyJsonSubset": { "ok": true, "scenario": "long" } },
    { "path": "/__console/async?marker=check-async&delayMs=50", "expectedStatus": 200, "bodyJsonSubset": { "ok": true, "scenario": "async", "delayMs": 50 } },
    { "path": "/__console/child?marker=check-child", "expectedStatus": 200, "bodyJsonSubset": { "ok": true, "scenario": "child" } },
    { "path": "/__console/raw?marker=check-raw", "expectedStatus": 200, "bodyJsonSubset": { "ok": true, "scenario": "raw", "consoleLogs": 1, "directWrites": 2 } },
    { "path": "/__console/error?marker=check-error", "expectedStatus": 500, "bodyJsonSubset": { "ok": false, "scenario": "error" } },
